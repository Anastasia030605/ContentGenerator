# Telegram канал (публичный)
# Укажите username канала без @
TELEGRAM_CHANNEL_USERNAME=your_channel_username

# ========== AI PROVIDER ==========
# Дефолтный провайдер (фронт может переопределить через API).
# Доступные: groq, google, ollama, openai, anthropic
AI_PROVIDER=groq

# ========== БЕСПЛАТНЫЕ ВАРИАНТЫ ==========

# Groq (БЕСПЛАТНО - облачный API с лимитами)
# Получите ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (БЕСПЛАТНО - тариф с лимитами)
# Получите ключ: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_MODEL=gemini-2.0-flash

# Ollama (БЕСПЛАТНО - локально на вашем компе)
# Установите: https://ollama.com/download
# Затем: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ========== ПЛАТНЫЕ ВАРИАНТЫ ==========

# OpenAI (ПЛАТНО - ~$0.10-1.00 на 100 постов)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (ПЛАТНО - ~$0.30-3.00 на 100 постов)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# RAG settings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PERSIST_DIRECTORY=data/chroma

# Content planning
CONTENT_PLAN_WEEKS=4
POSTS_PER_WEEK=7

# Paths
DATA_DIR=data
POSTS_DB_PATH=data/posts.db
SESSION_NAME=content_generator
